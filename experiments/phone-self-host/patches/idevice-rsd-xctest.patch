+    /// Uploads a disk image from a file, with at most one 64 KiB write pending.
+    #[cfg(not(target_arch = "wasm32"))]
+    pub async fn upload_image_file(
+        &mut self,
+        image_type: impl Into<String>,
+        path: impl AsRef<std::path::Path>,
+        signature: Vec<u8>,
+    ) -> Result<(), IdeviceError> {
+        use tokio::io::AsyncReadExt;
+        let mut image = tokio::fs::File::open(path).await?;
+        let size = image.metadata().await?.len();
+        if size == 0 || size > 1_073_741_824 {
+            return Err(IdeviceError::UnexpectedResponse("invalid image size".into()));
+        }
+        let mut request = plist::Dictionary::new();
+        request.insert("Command".into(), plist::Value::String("ReceiveBytes".into()));
+        request.insert("ImageType".into(), plist::Value::String(image_type.into()));
+        request.insert("ImageSize".into(), plist::Value::Integer(size.into()));
+        request.insert("ImageSignature".into(), plist::Value::Data(signature));
+        self.idevice.send_plist(plist::Value::Dictionary(request)).await?;
+        let reply: plist::Dictionary = self.idevice.read_plist().await?;
+        if reply.get("Status").and_then(|v| v.as_string()) != Some("ReceiveBytesAck") {
+            return Err(IdeviceError::UnexpectedResponse("image upload not acknowledged".into()));
+        }
+        let mut buffer = vec![0u8; 65_536];
+        let mut sent = 0u64;
+        loop {
+            let count = image.read(&mut buffer).await?;
+            if count == 0 { break; }
+            self.idevice.send_raw(&buffer[..count]).await?;
+            sent += count as u64;
+        }
+        if sent != size { return Err(IdeviceError::UnexpectedResponse("image size changed".into())); }
+        let reply: plist::Dictionary = self.idevice.read_plist().await?;
+        if reply.get("Status").and_then(|v| v.as_string()) != Some("Complete") {
+            return Err(IdeviceError::UnexpectedResponse("image upload incomplete".into()));
+        }
         Ok(())
     }
 
